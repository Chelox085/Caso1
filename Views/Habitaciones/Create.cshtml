@model Caso1.Models.Habitacion
@{
    ViewData["Title"] = "Registrar Nueva Habitación";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-plus-circle me-2 text-primary"></i>Registrar Habitación</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Volver a la Lista</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="CodigoDeHabitacion" class="form-label fw-bold">Código (Ej: JUN-001)</label>
                    <input asp-for="CodigoDeHabitacion" class="form-control" placeholder="Máx 7 letras" />
                    <span asp-validation-for="CodigoDeHabitacion" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NombreDeHabitacion" class="form-label fw-bold">Nombre descriptivo</label>
                    <input asp-for="NombreDeHabitacion" class="form-control" />
                    <span asp-validation-for="NombreDeHabitacion" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="TipoDeHabitacion" class="form-label fw-bold">Tipo de Habitación</label>
                    <select asp-for="TipoDeHabitacion" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="1">1 - Junior</option>
                        <option value="2">2 - Superior</option>
                        <option value="3">3 - Suite</option>
                    </select>
                    <span asp-validation-for="TipoDeHabitacion" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="CantidadDeHuespedesPermitidos" class="form-label fw-bold">Máx. Huéspedes</label>
                    <input asp-for="CantidadDeHuespedesPermitidos" class="form-control" type="number" min="1" />
                    <span asp-validation-for="CantidadDeHuespedesPermitidos" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CantidadDeCamas" class="form-label fw-bold">Cant. Camas</label>
                    <input asp-for="CantidadDeCamas" class="form-control" type="number" min="1" />
                    <span asp-validation-for="CantidadDeCamas" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CantidadDeBanos" class="form-label fw-bold">Cant. Baños</label>
                    <input asp-for="CantidadDeBanos" class="form-control" type="number" min="1" />
                    <span asp-validation-for="CantidadDeBanos" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Ubicacion" class="form-label fw-bold">Ubicación</label>
                    <input asp-for="Ubicacion" class="form-control" placeholder="Ej: Piso 1" />
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EncargadoDeLimpieza" class="form-label fw-bold">Responsable de Limpieza</label>
                    <input asp-for="EncargadoDeLimpieza" class="form-control" />
                    <span asp-validation-for="EncargadoDeLimpieza" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CostoDeLimpieza" class="form-label fw-bold">Costo Limpieza</label>
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        <input asp-for="CostoDeLimpieza" class="form-control" type="number" step="0.01" min="0.01" />
                    </div>
                    <span asp-validation-for="CostoDeLimpieza" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CostoDeReserva" class="form-label fw-bold">Costo por Noche</label>
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        <input asp-for="CostoDeReserva" class="form-control" type="number" step="0.01" min="0.01" />
                    </div>
                    <span asp-validation-for="CostoDeReserva" class="text-danger"></span>
                </div>

                <div class="col-12 mt-4">
                    <div class="form-check form-switch fs-5">
                        <input asp-for="Estado" class="form-check-input" type="checkbox" id="estadoSwitch" checked>
                        <label class="form-check-label fw-bold text-success" for="estadoSwitch">Habitación Activa (Disponible para reservas)</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <button type="submit" class="btn btn-primary btn-lg px-5">Guardar Habitación</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}