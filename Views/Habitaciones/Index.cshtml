@model IEnumerable<Caso1.ViewModels.HabitacionListItemViewModel>
@{
    ViewData["Title"] = "Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Módulo de Habitaciones</h1>
        <p class="text-muted mb-0">CRUD sobre la tabla <code>HABITACIONES</code> usando Entity Framework Core.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Registrar Habitación</a>
</div>

<div class="table-card p-3 border rounded shadow-sm bg-white">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Ubicación</th>
                <th>Huéspedes</th>
                <th>Camas</th>
                <th>Baños</th>
                <th>Responsable</th>
                <th>Limpieza</th>
                <th>Reserva (Noche)</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="12" class="text-center text-muted">No hay habitaciones registradas.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Habitacion.CodigoDeHabitacion</td>
                        <td>@item.Habitacion.NombreDeHabitacion</td>
                        <td>@item.Habitacion.Ubicacion</td>
                        <td>@item.Habitacion.CantidadDeHuespedesPermitidos</td>
                        <td>@item.Habitacion.CantidadDeCamas</td>
                        <td>@item.Habitacion.CantidadDeBanos</td>
                        <td>@item.Habitacion.EncargadoDeLimpieza</td>
                        <td>@item.Habitacion.CostoDeLimpieza.ToString("C")</td>
                        <td>@item.Habitacion.CostoDeReserva.ToString("C")</td>
                        <td>
                            <span class="fw-semibold">@item.TipoDeHabitacionProsa</span>
                        </td>
                        <td>
                            <span class="badge @(item.Habitacion.Estado ? "bg-success" : "bg-secondary")">
                                @item.EstadoProsa
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Habitacion.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-info" asp-controller="Reservacion" asp-action="History" asp-route-idHabitacion="@item.Habitacion.Id">Ver</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>