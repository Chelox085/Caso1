@model Caso1.ViewModels.DetallesReservaViewModel

<div class="row g-3">
    <div class="col-sm-6"><span class="text-muted d-block small">Nombre</span><strong>@Model.Reservacion.NombreDeLaPersona</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Teléfono</span><strong>@Model.Reservacion.Telefono</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Correo</span><strong>@Model.Reservacion.Correo</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Identificación</span><strong>@Model.Reservacion.Identificacion</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Fecha de nacimiento</span><strong>@Model.Reservacion.FechaNacimiento.ToString("dd/MM/yyyy")</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Dirección</span><strong>@Model.Reservacion.Direccion</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Código de habitación</span><strong>@Model.Habitacion.CodigoDeHabitacion</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Tipo de habitación</span><strong>@Model.TipoDeHabitacionProsa</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Cantidad de personas</span><strong>@Model.Reservacion.CantidadDePersonas</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Monto total</span><strong>@Model.Reservacion.MontoTotal.ToString("C")</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Fecha inicio</span><strong>@Model.Reservacion.FechaInicioReserva.ToString("dd/MM/yyyy")</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Fecha fin</span><strong>@Model.Reservacion.FechaFinReserva.ToString("dd/MM/yyyy")</strong></div>
    <div class="col-sm-6"><span class="text-muted d-block small">Fecha de reservación</span><strong>@Model.Reservacion.FechaDeRegistro.ToString("dd/MM/yyyy HH:mm")</strong></div>
</div>