@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-shell">
    <div class="auth-card-wrap">
        <div class="auth-welcome-panel">
            <i class="fa-solid fa-hotel"></i>
            <h1>Bienvenido al Hotel Los Patitos</h1>
            <p>Reserva en línea · Habitaciones Junior, Superior y Suite</p>
        </div>
        <div class="auth-form-side">
            <div class="auth-form-card">
                <h1 class="h4 mb-1">Iniciar sesión</h1>
                <p class="text-muted small mb-4">Ingresa con tu correo y contraseña.</p>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        <label asp-for="Input.Email">Correo electrónico</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Contraseña" />
                        <label asp-for="Input.Password">Contraseña</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label small" asp-for="Input.RememberMe">Recordarme</label>
                    </div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg">Iniciar sesión</button>
                </form>

                <div class="auth-links">
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Crear una cuenta nueva</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}